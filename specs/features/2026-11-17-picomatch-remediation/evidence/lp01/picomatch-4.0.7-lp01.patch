+// Local LP-01 prototype: reuse the risky-pattern literal fallback.
+// Scan once without regex backtracking; escapes, quotes and brackets are literals.
+const hasUnescapedStar = branch => {
+  let escaped = false;
+  let quote = false;
+  let bracket = 0;
+
+  for (const ch of branch) {
+    if (escaped) {
+      escaped = false;
+      continue;
+    }
+    if (ch === '\\') {
+      escaped = true;
+      continue;
+    }
+    if (ch === '"') {
+      quote = !quote;
+      continue;
+    }
+    if (quote) continue;
+    if (ch === '[') {
+      bracket++;
+      continue;
+    }
+    if (ch === ']' && bracket > 0) {
+      bracket--;
+      continue;
+    }
+    if (bracket === 0 && ch === '*') return true;
+  }
+  return false;
+};
