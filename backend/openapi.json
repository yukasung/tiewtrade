  "info": {
    "description": "เทรดคริปโตแบบ Spot — ยืนยันตัวตนด้วย session ฝั่งเซิร์ฟเวอร์",
    "title": "TiewTrade API",
    "version": "0.2.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api-keys": {
      "get": {
        "description": "รายการ key ของผู้ใช้คนนี้ — หน้าเว็บเรียกเป็นรอบ ๆ เพื่อดูสถานะ\n\nเส้นทางนี้ **ไม่ต่ออายุ session** (`routing_policy.py`) เพราะการ poll\nไม่ควรทำให้ session ไม่มีวันหมดอายุ",
        "operationId": "list_keys_api_keys_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/KeyView"
                  },
                  "title": "Response List Keys Api Keys Get",
